{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Easy Blog Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "posts"
  ],
  "properties": {
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authorId",
          "status",
          "date",
          "title",
          "description",
          "content",
          "coverPhoto",
          "blogPhoto",
          "permaLink",
          "expDate",
          "catName",
          "catDesc",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "authorId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "default": "draft"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "Main post body stored as Markdown."
          },
          "coverPhoto": {
            "$ref": "#/$defs/photo"
          },
          "blogPhoto": {
            "$ref": "#/$defs/photo"
          },
          "permaLink": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "expDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "catName": {
            "type": "string"
          },
          "catDesc": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "$defs": {
    "photo": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src",
            "alt"
          ],
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
