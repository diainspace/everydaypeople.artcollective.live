{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Easy CMS Administration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admin",
    "site"
  ],
  "properties": {
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "username",
        "shortName",
        "passwordHash",
        "passwordUpdatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "passwordHash": {
          "type": "string",
          "minLength": 1
        },
        "passwordUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "timeZone",
        "postsPerPage"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "postsPerPage": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        }
      }
    }
  }
}
